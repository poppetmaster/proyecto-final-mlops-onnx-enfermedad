# Variables de entorno - DEV
# Copiar a .env.dev y completar los valores reales

# ── Entorno ─────────────────────────────────
ENVIRONMENT=dev
MODEL_VERSION=v1.0.0-dev
LOG_LEVEL=INFO

# ── Modelo local ────────────────────────────
MODEL_PATH=models/modelo_enfermedad.onnx
TEST_DATA_PATH=data/test_data.csv

# ── Google Cloud Storage ───────────────────
GCS_PROJECT_ID=mi-proyecto-icesi
GCS_MODEL_BUCKET=icesi-mlops-models-dev
GCS_MODEL_BLOB=modelo_enfermedad.onnx
GCS_DATA_BUCKET=icesi-mlops-data-dev
GCS_TEST_DATA_BLOB=test_data.csv
GCS_LOGS_BUCKET=icesi-mlops-logs-dev
PREDICTIONS_FILE=predicciones_dev.txt

# ── Validación ──────────────────────────────
METRIC_THRESHOLD=0.80
METRIC_NAME=f1_weighted

# ── Cloud Run ───────────────────────────────
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=mlops-enfermedad-dev
ARTIFACT_REGISTRY_REPO=mlops-enfermedad
