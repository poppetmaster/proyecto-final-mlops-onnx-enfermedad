# Variables de entorno - PROD
# Copiar a .env.prod y completar los valores reales

# ── Entorno ─────────────────────────────────
ENVIRONMENT=prod
MODEL_VERSION=v1.0.0
LOG_LEVEL=INFO

# ── Modelo local ────────────────────────────
MODEL_PATH=models/modelo_enfermedad.onnx
TEST_DATA_PATH=data/test_data.csv

# ── Google Cloud Storage ───────────────────
GCS_PROJECT_ID=mi-proyecto-icesi
GCS_MODEL_BUCKET=icesi-mlops-models-prod
GCS_MODEL_BLOB=modelo_enfermedad.onnx
GCS_DATA_BUCKET=icesi-mlops-data-prod
GCS_TEST_DATA_BLOB=test_data.csv
GCS_LOGS_BUCKET=icesi-mlops-logs-prod
PREDICTIONS_FILE=predicciones_prod.txt

# ── Validación ──────────────────────────────
METRIC_THRESHOLD=0.85
METRIC_NAME=f1_weighted

# ── Cloud Run ───────────────────────────────
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=mlops-enfermedad-prod
ARTIFACT_REGISTRY_REPO=mlops-enfermedad
